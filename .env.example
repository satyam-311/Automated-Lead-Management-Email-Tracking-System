# ─────────────────────────────────────────────────────────────────────────────
#  LeadFlow — Environment Variables Template
#  Copy this file to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your regular Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Tracker Server ────────────────────────────────────────────────────────────
# Local:      http://localhost:5000
# On Render:  https://leadflow-tracker.onrender.com  (your tracker service URL)
TRACKER_BASE=http://localhost:5000

# URL visitors land on after clicking the tracked link in the email
CLICK_REDIRECT_URL=https://github.com/yourusername/leadflow

# ── Render / Production ───────────────────────────────────────────────────────
# Port used by Flask tracker (Render injects $PORT automatically)
TRACKER_PORT=5000

# ── Supabase / PostgreSQL (required for Render deployment) ───────────────────
# Without this, both Render services use separate SQLite files and tracking
# will NOT reflect in the dashboard. Set this in BOTH Render services.
# Get the connection string from: Supabase → Settings → Database → URI
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
